---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Handmade crochet pieces by Carla. Custom orders welcome.',
  image = '/og-image.png',
} = Astro.props;

const siteUrl = 'https://handcrochetedbycarlaarias.netlify.app';
const pageTitle = `${title} | HandCrochetedByCarlaArias`;
const ogImage = `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / social share -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="HandCrochetedByCarlaArias — handmade crochet pieces" />

    <!-- Twitter / X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Netlify Identity (required for CMS login redirect) -->
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', function(user) {
          if (!user) {
            window.netlifyIdentity.on('login', function() {
              document.location.href = '/admin/';
            });
          }
        });

        // Explicitly open the widget when an invite/recovery token is in the URL
        var params = new URLSearchParams(window.location.hash.replace('#', '?'));
        if (params.get('invite_token') || params.get('recovery_token') || params.get('confirmation_token')) {
          window.netlifyIdentity.open();
        }
      }
    </script>
  </head>
  <body class="bg-cream text-brown-dark font-serif">
    <header class="sticky top-0 z-50 bg-cream/95 backdrop-blur border-b border-brown-light/30">
      <nav class="max-w-5xl mx-auto px-5 py-4 flex items-center justify-between">
        <a href="/" class="text-lg font-bold tracking-wide text-brown-dark hover:text-brown transition-colors">
          HandCrochetedByCarlaArias
        </a>

        <!-- Desktop nav -->
        <ul class="hidden sm:flex gap-6 text-sm tracking-wider uppercase">
          <li><a href="/" class="hover:text-brown transition-colors">Home</a></li>
          <li><a href="/gallery" class="hover:text-brown transition-colors">Gallery</a></li>
          <li><a href="/custom-orders" class="hover:text-brown transition-colors">Custom Orders</a></li>
          <li><a href="/about" class="hover:text-brown transition-colors">About</a></li>
          <li><a href="/contact" class="hover:text-brown transition-colors">Contact</a></li>
        </ul>

        <!-- Hamburger button -->
        <button
          id="menu-btn"
          class="sm:hidden flex flex-col gap-1.5 p-2 -mr-2"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <span class="block w-6 h-0.5 bg-brown-dark transition-all duration-300" id="bar1"></span>
          <span class="block w-6 h-0.5 bg-brown-dark transition-all duration-300" id="bar2"></span>
          <span class="block w-6 h-0.5 bg-brown-dark transition-all duration-300" id="bar3"></span>
        </button>
      </nav>

      <!-- Mobile menu -->
      <div
        id="mobile-menu"
        class="sm:hidden hidden border-t border-brown-light/30 bg-cream/98"
      >
        <ul class="flex flex-col px-5 py-4 gap-4 text-sm tracking-wider uppercase">
          <li><a href="/" class="block hover:text-brown transition-colors">Home</a></li>
          <li><a href="/gallery" class="block hover:text-brown transition-colors">Gallery</a></li>
          <li><a href="/custom-orders" class="block hover:text-brown transition-colors">Custom Orders</a></li>
          <li><a href="/about" class="block hover:text-brown transition-colors">About</a></li>
          <li><a href="/contact" class="block hover:text-brown transition-colors">Contact</a></li>
        </ul>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="mt-16 border-t border-brown-light/30 bg-cream">
      <div class="max-w-5xl mx-auto px-5 py-8 flex flex-col items-center gap-4 text-sm text-brown/70 text-center">
        <a
          href="https://www.instagram.com/HandCrochetedByCarlaArias"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 hover:text-brown transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
            <circle cx="12" cy="12" r="4"/>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>
          </svg>
          @HandCrochetedByCarlaArias
        </a>
        <p>&copy; {new Date().getFullYear()} HandCrochetedByCarlaArias. All rights reserved.</p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('menu-btn')!;
      const menu = document.getElementById('mobile-menu')!;
      const bar1 = document.getElementById('bar1')!;
      const bar2 = document.getElementById('bar2')!;
      const bar3 = document.getElementById('bar3')!;

      btn.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!open));
        // Animate to X
        if (!open) {
          bar1.style.transform = 'translateY(8px) rotate(45deg)';
          bar2.style.opacity = '0';
          bar3.style.transform = 'translateY(-8px) rotate(-45deg)';
        } else {
          bar1.style.transform = '';
          bar2.style.opacity = '';
          bar3.style.transform = '';
        }
      });

      // Close menu on nav link click
      menu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          menu.classList.add('hidden');
          bar1.style.transform = '';
          bar2.style.opacity = '';
          bar3.style.transform = '';
        });
      });
    </script>
  </body>
</html>
