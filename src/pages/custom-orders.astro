---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Custom Orders" description="Request a custom handmade crochet piece from Carla.">
  <section class="max-w-3xl mx-auto px-5 py-14">
    <div class="text-center mb-10">
      <p class="text-brown uppercase tracking-widest text-xs sm:text-sm mb-3">Made to order</p>
      <h1 class="text-3xl sm:text-4xl font-bold mb-4">Custom Orders</h1>
      <p class="text-brown/70 text-base sm:text-lg">
        Have something specific in mind? I'd love to make it for you. Fill out the form below and I'll be in touch.
      </p>
    </div>

    <!-- How it works -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12">
      <div class="text-center p-5 bg-blush/20 rounded-2xl">
        <div class="text-3xl mb-2">1</div>
        <h3 class="font-bold mb-1">Submit a request</h3>
        <p class="text-sm text-brown/70">Tell me what you have in mind — size, color, style.</p>
      </div>
      <div class="text-center p-5 bg-sage/20 rounded-2xl">
        <div class="text-3xl mb-2">2</div>
        <h3 class="font-bold mb-1">We chat details</h3>
        <p class="text-sm text-brown/70">I'll reach out to confirm the design and get a timeline.</p>
      </div>
      <div class="text-center p-5 bg-brown-light/20 rounded-2xl">
        <div class="text-3xl mb-2">3</div>
        <h3 class="font-bold mb-1">Made just for you</h3>
        <p class="text-sm text-brown/70">Your piece is handcrafted and shipped with care.</p>
      </div>
    </div>

    <!-- Order form -->
    <form name="custom-order" method="POST" data-netlify="true" class="space-y-5">
      <input type="hidden" name="form-name" value="custom-order" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="name" class="block text-sm font-semibold mb-1">Your Name</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full border border-brown-light/50 rounded-xl px-4 py-3 bg-white/60 focus:outline-none focus:ring-2 focus:ring-brown/40"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold mb-1">Email</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full border border-brown-light/50 rounded-xl px-4 py-3 bg-white/60 focus:outline-none focus:ring-2 focus:ring-brown/40"
          />
        </div>
      </div>

      <div>
        <label for="item" class="block text-sm font-semibold mb-1">What would you like made?</label>
        <input
          id="item"
          name="item"
          type="text"
          placeholder="e.g. baby blanket, tote bag, stuffed animal…"
          required
          class="w-full border border-brown-light/50 rounded-xl px-4 py-3 bg-white/60 focus:outline-none focus:ring-2 focus:ring-brown/40"
        />
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="colors" class="block text-sm font-semibold mb-1">Color preferences</label>
          <input
            id="colors"
            name="colors"
            type="text"
            placeholder="e.g. sage green, earthy tones…"
            class="w-full border border-brown-light/50 rounded-xl px-4 py-3 bg-white/60 focus:outline-none focus:ring-2 focus:ring-brown/40"
          />
        </div>
        <div>
          <label for="timeline" class="block text-sm font-semibold mb-1">Do you have a deadline?</label>
          <input
            id="timeline"
            name="timeline"
            type="text"
            placeholder="e.g. end of June, no rush…"
            class="w-full border border-brown-light/50 rounded-xl px-4 py-3 bg-white/60 focus:outline-none focus:ring-2 focus:ring-brown/40"
          />
        </div>
      </div>

      <div>
        <label for="details" class="block text-sm font-semibold mb-1">Any other details?</label>
        <textarea
          id="details"
          name="details"
          rows="4"
          placeholder="Size, who it's for, inspiration images, anything else…"
          class="w-full border border-brown-light/50 rounded-xl px-4 py-3 bg-white/60 focus:outline-none focus:ring-2 focus:ring-brown/40 resize-none"
        ></textarea>
      </div>

      <!-- Gift section -->
      <div class="border border-brown-light/40 rounded-2xl p-5 bg-blush/10 space-y-4">
        <div class="flex items-start gap-3">
          <input
            id="is-gift"
            name="is_gift"
            type="checkbox"
            class="mt-1 w-4 h-4 accent-brown cursor-pointer"
          />
          <label for="is-gift" class="text-sm font-semibold cursor-pointer">
            This is a gift 🎁
            <span class="block font-normal text-brown/60 mt-0.5">All gifts are carefully wrapped with love.</span>
          </label>
        </div>
        <div id="gift-note-field" class="hidden">
          <label for="gift-note" class="block text-sm font-semibold mb-1">Gift note <span class="font-normal text-brown/50">(optional)</span></label>
          <textarea
            id="gift-note"
            name="gift_note"
            rows="3"
            placeholder="e.g. Happy birthday! Wishing you all the best…"
            class="w-full border border-brown-light/50 rounded-xl px-4 py-3 bg-white/60 focus:outline-none focus:ring-2 focus:ring-brown/40 resize-none text-sm"
          ></textarea>
        </div>
      </div>

      <p class="text-xs text-brown/50 text-center leading-relaxed">
        ✦ Please note: since every piece is entirely handmade, minor variations or small imperfections
        may occur — this is part of the charm of handcrafted work and not considered a defect.
      </p>

      <button
        type="submit"
        class="w-full bg-brown text-cream py-4 rounded-full text-base font-semibold hover:bg-brown-dark transition-colors tracking-wide"
      >
        Send My Request
      </button>
    </form>
  </section>
</Layout>

<script>
  const checkbox = document.getElementById('is-gift') as HTMLInputElement;
  const noteField = document.getElementById('gift-note-field')!;

  checkbox.addEventListener('change', () => {
    noteField.classList.toggle('hidden', !checkbox.checked);
  });
</script>
