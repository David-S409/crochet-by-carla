---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gallery" description="Browse handmade crochet pieces by Carla.">
  <section class="max-w-5xl mx-auto px-5 py-14">
    <div class="text-center mb-10">
      <p class="text-brown uppercase tracking-widest text-xs sm:text-sm mb-3">The work</p>
      <h1 class="text-3xl sm:text-4xl font-bold">Gallery</h1>
    </div>

    <div id="gallery-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4 min-h-48">
      <div id="gallery-loading" class="col-span-2 sm:col-span-3 flex items-center justify-center py-20 text-brown/40 text-sm">
        Loading...
      </div>
    </div>

    <div class="text-center mt-10">
      <p class="text-brown/70 text-sm mb-4">See something you love or want something made just for you?</p>
      <a href="/custom-orders" class="bg-brown text-cream px-8 py-3 rounded-full hover:bg-brown-dark transition-colors text-sm">
        Request a Custom Order
      </a>
    </div>
  </section>

  <!-- Lightbox -->
  <div
    id="lightbox"
    class="fixed inset-0 z-50 bg-black/90 hidden items-center justify-center p-4"
    role="dialog"
    aria-modal="true"
    aria-label="Image viewer"
  >
    <button
      id="lightbox-close"
      class="absolute top-4 right-5 text-white/70 hover:text-white text-4xl leading-none"
      aria-label="Close"
    >&times;</button>
    <img
      id="lightbox-img"
      src=""
      alt=""
      class="max-h-[90vh] max-w-[90vw] rounded-2xl object-contain shadow-2xl"
    />
  </div>
</Layout>

<script>
  const lightbox = document.getElementById('lightbox')!;
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const closeBtn = document.getElementById('lightbox-close')!;

  function openLightbox(src: string) {
    lightboxImg.src = src;
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    lightboxImg.src = '';
    document.body.style.overflow = '';
  }

  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeLightbox(); });

  async function loadGallery() {
    const grid = document.getElementById('gallery-grid')!;
    const loading = document.getElementById('gallery-loading')!;

    try {
      const res = await fetch('/.netlify/functions/list-images');
      const json = await res.json();

      loading.remove();

      if (!res.ok || !Array.isArray(json)) {
        grid.innerHTML = `<p class="col-span-2 sm:col-span-3 text-center text-brown/40 py-20 text-sm">Could not load photos.</p>`;
        console.error('list-images error:', json);
        return;
      }

      const images: { key: string; src: string }[] = json;

      if (!images.length) {
        grid.innerHTML = '<p class="col-span-2 sm:col-span-3 text-center text-brown/40 py-20 text-sm">No photos yet — check back soon!</p>';
        return;
      }

      for (const { src } of images) {
        const btn = document.createElement('button');
        btn.className = 'aspect-square rounded-xl sm:rounded-2xl overflow-hidden bg-blush/30 hover:scale-[1.02] active:scale-[0.98] transition-transform duration-300 cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-brown/50';
        btn.setAttribute('aria-label', 'View larger');

        const img = document.createElement('img');
        img.src = src;
        img.alt = 'Handmade crochet piece';
        img.className = 'w-full h-full object-cover pointer-events-none';
        img.loading = 'lazy';

        btn.appendChild(img);
        grid.appendChild(btn);
        btn.addEventListener('click', () => openLightbox(src));
      }
    } catch {
      loading.textContent = 'Could not load photos.';
    }
  }

  loadGallery();
</script>
