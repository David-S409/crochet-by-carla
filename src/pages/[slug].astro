---
import Layout from '../layouts/Layout.astro';
import { client, urlFor } from '../lib/sanity';
import { toHTML } from '@portabletext/to-html';

export async function getStaticPaths() {
  const pages = await client.fetch(`*[_type == "page" && defined(slug.current)]{ slug }`);
  return pages.map((p: any) => ({ params: { slug: p.slug.current } }));
}

const { slug } = Astro.params;
const page = await client.fetch(
  `*[_type == "page" && slug.current == $slug][0]{ title, content }`,
  { slug }
);

if (!page) return Astro.redirect('/');

const contentHTML = toHTML(page.content ?? [], {
  components: {
    types: {
      image: ({ value }: any) =>
        `<img src="${urlFor(value).width(800).url()}" alt="${value.alt || ''}" class="rounded-xl w-full my-6" />`,
    },
  },
});
---

<Layout title={page.title}>
  <section class="max-w-3xl mx-auto px-5 py-14">
    <h1 class="text-3xl sm:text-4xl font-bold mb-10">{page.title}</h1>
    <div
      class="prose prose-brown leading-relaxed space-y-4 text-brown/80"
      set:html={contentHTML}
    />
  </section>
</Layout>
